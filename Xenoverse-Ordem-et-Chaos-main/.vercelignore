# Game assets (not needed for web app - but Graphics IS needed for icons)
Audio
# Keep Data generally ignored (it is large) but allow the specific files the exporter needs
Data/*
!Data/MapInfos.rxdata
!Data/types.dat
!Data/abilities.dat
!Data/species.dat
!Data/moves.dat
!Data/encounters.dat
!Data/items.dat
!Data/trainers.dat
Fonts
screenshots
test-evidence
test-results
out
# Ignore most of tools/ but allow the export script (needed at build time)
tools/*
!tools/export/
!tools/export/**
docs

# Game binaries
*.exe
*.dll
*.sf2

# Zone identifiers (Windows metadata)
*:Zone.Identifier

# Build artifacts
node_modules
*.log
# Keep prebuilt db/graph in the repo available to Vercel
!out/dex.db
!out/map_graph.json

# Video files
*.webm

# Development files
.env*.local
*.tsbuildinfo
.git
